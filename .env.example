# ============ 大模型 ============
# 开发期指向支持 tool calling 的模型（见 SPEC 4.3）
MODEL_PROVIDER=openai_compatible
MODEL_NAME=deepseek-chat
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
# 上下文预算。纯文字对话 4096 够用；
# 要用「从相册选图提问」的话建议调到 8192 以上——一张 1280 的图实测约 3-5k token，
# 留在 4096 会让折叠频繁触发，前文的图很快被摘要掉
MAX_CONTEXT_TOKENS=4096

# ============ 图片生成 ============
# 取值：custom | none
# 推荐直接指向火山方舟（OpenAI 兼容的 Images API），无需部署 Infinite Canvas；
# 若改用 Infinite Canvas 代理，把 ENDPOINT 换成其地址、TOKEN 换成抓包结果即可
IMAGE_BACKEND=custom
CUSTOM_IMAGE_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/images/generations
CUSTOM_IMAGE_TOKEN=Bearer <ARK_API_KEY>
CUSTOM_IMAGE_MODEL=doubao-seedream-4-0-20260415
CUSTOM_IMAGE_SIZE=2K
# 图片以临时链接返回（24 小时内有效，需及时下载）
CUSTOM_IMAGE_RESPONSE_FORMAT=url
# 是否在图片右下角加「AI生成」水印。方舟接口默认 true，必须显式传 false 才能关闭
CUSTOM_IMAGE_WATERMARK=false

# ============ 视频生成（直连火山方舟）============
# 取值：ark | none
# 本项目不提供生视频功能，默认 none；改回 ark 并开通 seedance 模型即可启用
VIDEO_BACKEND=none
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_VIDEO_MODEL=doubao-seedance-2-5-260628
ARK_VIDEO_RATIO=adaptive
ARK_VIDEO_GENERATE_AUDIO=true
ARK_VIDEO_WATERMARK=false
# 轮询策略：3 秒起，逐步退避到 10 秒上限
ARK_VIDEO_POLL_INITIAL_SEC=3
ARK_VIDEO_POLL_MAX_SEC=10
ARK_VIDEO_TIMEOUT_SEC=600

# ============ 媒体任务 ============
# 完成后任务在内存中保留多久
MEDIA_TASK_TTL_SEC=3600

# ============ 存储 ============
# memory = 进程内存（重启即丢，仅开发用）；redis = 持久化，推荐
STORAGE_BACKEND=redis
REDIS_URL=redis://localhost:6379/0
# 会话过期秒数，0 表示不过期
SESSION_TTL_SEC=0

# ============ 文件系统沙箱 ============
# 允许 agent 读写的目录白名单，逗号分隔；留空表示禁止所有文件操作
ALLOWED_ROOTS=

# ============ 登录态采集（plugin 组 B）============
# 默认关闭：置 true 后前端才会展示社媒入口。
# 本模块个人自用、不随核心开源发布；抓取平台内容违反其服务条款且有封号风险
ENABLE_SESSION_FETCH=false
# Cookie 存放目录，由 scripts/apply_cookies.py 写入，每平台一个文件 <平台名>.txt
# （抖音/小红书/B站/微博/知乎/贴吧/小黑盒/BOSS直聘 共 8 个平台）
COOKIE_DIR=cookies
# MediaCrawler 项目路径（抖音/小红书/B站/微博/知乎/贴吧 六平台走它）
# 默认值仅是建议；若 D:\ 根目录不可写，请改成任意可写路径
MEDIACRAWLER_PATH=D:/MediaCrawler
# MediaCrawler 子进程超时（秒）；源外层超时会取其 +20，见 SPEC 4.8
# 实测单次采集下限就有百秒级开销（B站 limit=2 约 147s），留足余量
MEDIACRAWLER_TIMEOUT=300
# 参与采集的平台，逗号分隔；平台名同时是 capabilities.platforms 的取值
CRAWLER_PLATFORMS=douyin,xiaohongshu,bilibili,weibo,zhihu,tieba

# ============ 检索类 Key ============
WEATHER_API_KEY=
MAP_API_KEY=
# 必应检索：留空则回退抓取 cn.bing.com 的 HTML 结果页（有 1.2s 进程内限速）
BING_SEARCH_API_KEY=

# ============ 检索层（SPEC 4.7 / 4.8）============
# 单个检索源的默认外层超时 = max(SOURCE_TIMEOUT_SEC*3, 45) 秒
SOURCE_TIMEOUT_SEC=20
# 源不可用或源内失败时是否返回带 mock 标记的降级占位结果（false 则直接跳过该源）
ENABLE_MOCK_FALLBACK=true
# 按 URL 抓正文的超时与单次响应体上限（字节）
FETCH_TIMEOUT_SEC=15
MAX_FETCH_BYTES=1500000

# ============ 酒店价格（LiteAPI）============
# 鉴权方式：请求头 X-API-Key；主接口 POST /hotels/rates
LITEAPI_KEY=
LITEAPI_BASE_URL=https://api.liteapi.travel/v3.0

# ============ 服务 ============
CORS_ORIGINS=http://localhost:3001
# 前端访问密码（web/serve.py 的 Basic Auth）。
# 留空 = 不启用；用隧道/公网暴露时务必填上，否则任何人都能调用你的模型额度。
WEB_AUTH_USER=
WEB_AUTH_PASS=
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# ============ 可观测性 ============
# 链路追踪。不配也能跑：trace_id 仍会生成并打进日志与 SSE 事件，
# 只是不会上报到 LangSmith 面板。
# langsmith 已是 langchain-core 的传递依赖，无需额外安装。
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ocean-travel-agent
# 私有部署或自建网关时填写；留空走官方 https://api.smith.langchain.com
LANGSMITH_ENDPOINT=

# ---------------- 用量与成本 ----------------
# 会话累计 token 上限，超限后拒绝新一轮对话；0 表示不限制
MAX_TOKENS_PER_SESSION=0
# 覆盖内置价目表：元/百万 token，格式「输入,输出」。
# 留空则按 MODEL_NAME 前缀匹配 app/core/usage.py 里的 PRICE_TABLE；
# 匹配不到时成本报 null（表示「不知道」，不是免费）
MODEL_PRICE=

# ---------------- 工具重试 ----------------
# 总尝试次数（含首次）。只对超时/连接/5xx/限流生效，
# 权限拒绝与参数错误一律不重试
TOOL_RETRY_ATTEMPTS=3
# 指数退避的基础等待秒数
TOOL_RETRY_BASE_DELAY=0.4
# 单轮工具调用预算：同一工具最多几次、整轮总共几次（0 表示不限）。
# 模型对同一工具换参数反复试探时，光靠 prompt 约束不住，这里做硬性兜底：
# 超限不报错，而是返回 TOOL_BUDGET_EXCEEDED 文本让模型基于已有信息作答
TOOL_MAX_CALLS_PER_TOOL=4
TOOL_MAX_CALLS_TOTAL=12
