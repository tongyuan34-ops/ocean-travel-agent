{
  "openapi": "3.1.0",
  "info": {
    "title": "旅行规划助手后端",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Api V1 Health Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system/capabilities": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Capabilities",
        "operationId": "capabilities_api_v1_system_capabilities_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Capabilities Api V1 System Capabilities Get"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chat/sessions": {
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Create Session",
        "description": "创建会话。",
        "operationId": "create_session_api_v1_chat_sessions_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionCreated"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chat/sessions/{session_id}": {
      "delete": {
        "tags": [
          "chat"
        ],
        "summary": "Delete Session",
        "description": "删除会话及其消息。",
        "operationId": "delete_session_api_v1_chat_sessions__session_id__delete",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chat/sessions/{session_id}/messages": {
      "get": {
        "tags": [
          "chat"
        ],
        "summary": "List Messages",
        "description": "拉取会话历史，用于刷新后恢复。",
        "operationId": "list_messages_api_v1_chat_sessions__session_id__messages_get",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageList"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "chat"
        ],
        "summary": "Send Message",
        "description": "发送消息，以 SSE 流式返回回答。",
        "operationId": "send_message_api_v1_chat_sessions__session_id__messages_post",
        "parameters": [
          {
            "name": "session_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Session Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MessageRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/tools": {
      "get": {
        "tags": [
          "tools"
        ],
        "summary": "List Tools",
        "description": "返回工具清单。category 与 SSE tool_call 事件里的取值保持一致。",
        "operationId": "list_tools_api_v1_tools_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ToolList"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/permissions/{request_id}/decision": {
      "post": {
        "tags": [
          "permissions"
        ],
        "summary": "Decide",
        "description": "前端对 permission_request 的裁决。\n\n未找到或已处理的 request_id 一律拒绝，不做任何默认放行。",
        "operationId": "decide_api_v1_permissions__request_id__decision_post",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Request Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/media/templates": {
      "get": {
        "tags": [
          "media"
        ],
        "summary": "List Templates",
        "description": "生图提示词模板库，供前端渲染模板选择器。",
        "operationId": "list_templates_api_v1_media_templates_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImageTemplateList"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/media/images": {
      "post": {
        "tags": [
          "media"
        ],
        "summary": "Create Image",
        "description": "提交生图任务，立即返回 pending。",
        "operationId": "create_image_api_v1_media_images_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImageRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskAccepted"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/media/videos": {
      "post": {
        "tags": [
          "media"
        ],
        "summary": "Create Video",
        "description": "提交生视频任务。带 ref_image 即为图生视频。",
        "operationId": "create_video_api_v1_media_videos_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VideoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskAccepted"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/media/tasks/{task_id}": {
      "get": {
        "tags": [
          "media"
        ],
        "summary": "Get Task",
        "description": "查询任务状态与结果。",
        "operationId": "get_task_api_v1_media_tasks__task_id__get",
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Task Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskStatusResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DecisionRequest": {
        "properties": {
          "granted": {
            "type": "boolean",
            "title": "Granted"
          },
          "remember": {
            "type": "boolean",
            "title": "Remember",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "granted"
        ],
        "title": "DecisionRequest"
      },
      "DecisionResponse": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "granted": {
            "type": "boolean",
            "title": "Granted"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "granted"
        ],
        "title": "DecisionResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImageRequest": {
        "properties": {
          "prompt": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Prompt",
            "description": "生成提示词"
          },
          "style": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Style",
            "description": "风格，如 checkin / poster / note"
          },
          "ref_image": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ref Image",
            "description": "参考图 URL"
          }
        },
        "type": "object",
        "required": [
          "prompt"
        ],
        "title": "ImageRequest"
      },
      "ImageTemplateItem": {
        "properties": {
          "key": {
            "type": "string",
            "title": "Key"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "scene": {
            "type": "string",
            "title": "Scene"
          },
          "style": {
            "type": "string",
            "title": "Style"
          },
          "composition": {
            "type": "string",
            "title": "Composition"
          },
          "lighting": {
            "type": "string",
            "title": "Lighting"
          },
          "example": {
            "type": "string",
            "title": "Example"
          }
        },
        "type": "object",
        "required": [
          "key",
          "label",
          "scene",
          "style",
          "composition",
          "lighting",
          "example"
        ],
        "title": "ImageTemplateItem",
        "description": "一个生图模板。"
      },
      "ImageTemplateList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ImageTemplateItem"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "ImageTemplateList"
      },
      "MessageItem": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "role",
          "content",
          "created_at"
        ],
        "title": "MessageItem"
      },
      "MessageList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/MessageItem"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "MessageList"
      },
      "MessageRequest": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Message",
            "description": "用户输入"
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "MessageRequest"
      },
      "SessionCreated": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "created_at"
        ],
        "title": "SessionCreated"
      },
      "TaskAccepted": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "task_id",
          "status"
        ],
        "title": "TaskAccepted",
        "description": "创建任务的响应，HTTP 202。"
      },
      "TaskStatusResponse": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "result_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Result Url"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "task_id",
          "status"
        ],
        "title": "TaskStatusResponse",
        "description": "任务状态查询响应。"
      },
      "ToolItem": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          },
          "requires_permission": {
            "type": "boolean",
            "title": "Requires Permission"
          },
          "description": {
            "type": "string",
            "title": "Description"
          }
        },
        "type": "object",
        "required": [
          "name",
          "category",
          "enabled",
          "requires_permission",
          "description"
        ],
        "title": "ToolItem"
      },
      "ToolList": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ToolItem"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "items"
        ],
        "title": "ToolList"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VideoRequest": {
        "properties": {
          "prompt": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Prompt",
            "description": "生成提示词"
          },
          "duration": {
            "type": "integer",
            "maximum": 30.0,
            "minimum": 1.0,
            "title": "Duration",
            "description": "时长（秒）",
            "default": 5
          },
          "ref_image": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ref Image",
            "description": "首帧参考图 URL；传入即为图生视频"
          }
        },
        "type": "object",
        "required": [
          "prompt"
        ],
        "title": "VideoRequest"
      }
    }
  }
}